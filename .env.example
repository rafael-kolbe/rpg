# Copy to .env and fill in:  cp .env.example .env
# Used by `make up` (docker-compose.yml). Development (`make dev-*`) needs no .env.

# Password of the `rpg` Postgres user. A credential: never commit .env.
POSTGRES_PASSWORD=change-me

# Loopback port for the app (http://127.0.0.1:8083).
LOCAL_PORT=8083

# Build the sandbox (test scenarios + debug tools) into the image. Off by
# default: the published image never has it. For sandbox testing use
# `make dev-server` (always with it), or set true only on localhost.
SANDBOX=false
